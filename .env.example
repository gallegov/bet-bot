# ─── Telegram ───────────────────────────────────────────────
# Obtén el token hablando con @BotFather en Telegram
TELEGRAM_TOKEN=TU_BOT_TOKEN

# ─── Anthropic (Claude Vision) ──────────────────────────────
# Regístrate en https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ─── Google Sheets ──────────────────────────────────────────
# 1. Ve a https://console.cloud.google.com
# 2. Crea un proyecto → habilita "Google Sheets API" y "Google Drive API"
# 3. Crea credenciales → Cuenta de servicio → descarga el JSON
# 4. Comparte tu Google Sheet con el email de la cuenta de servicio
GOOGLE_CREDENTIALS_FILE=TUS_CREDENCIALES.json
GOOGLE_SHEET_ID=TU_GOOGLE_SHEET_ID

# ─── API deportiva (api-sports.io) ──────────────────────────
# Regístrate en https://rapidapi.com/api-sports/api/api-football
# El mismo key sirve para fútbol, baloncesto y tenis
API_FOOTBALL_KEY=TU_CLAVE_API_FUTBOL
API_SPORTS_KEY=TU_CLAVE_API_DEPORTES

# ─── Temas del grupo de Telegram ────────────────────────────
# Crea el grupo, activa "Temas" en ajustes del grupo, crea los 4 temas,
# luego arranca el bot y manda un mensaje en cada tema.
# El bot imprimirá en consola: [TOPIC DEBUG] thread_id=XXXX
# Copia cada número aquí según el tema correspondiente.
TOPIC_CAPTURAS=0
TOPIC_ESTADISTICAS=0
TOPIC_CIERRE=0
TOPIC_SALDO=0
TOPIC_SUREBETS=0

# ─── ID del grupo de Telegram ────────────────────────────
# Vendrá antes de cada numero de tema en los mensajes anteriores
ID_GRUPO=TU_ID_GRUPO_TELEGRAM
